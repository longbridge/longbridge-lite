{
  "id": "com.longbridge.desktop-lite",
  "name": "Longbridge Lite",
  "version": "0.6.0",
  "shell-version": "0.6.0",
  "entry": "main.js",
  "dependencies": {
    "omarchy-ui": "huacnlee/omarchy-ui"
  },
  "capabilities": {
    "fs": {
      "read": ["${pluginDir}"]
    },
    "network": {
      "hosts": [
        "openapi.longbridge.com",
        "openapi-quote.longbridge.com",
        "openapi-trade.longbridge.com"
      ]
    },
    "storage": true,
    "clipboard": {
      "write": true
    },
    "process": {
      "exit": true
    }
  }
}
